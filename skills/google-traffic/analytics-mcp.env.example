# Google Analytics MCP — copy values into ~/.zshrc, ~/.cursor/analytics-mcp.env, or shell profile
# Docs: https://github.com/googleanalytics/google-analytics-mcp

# Path from: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/.config/gcloud/application_default_credentials.json

# GCP project with Analytics Admin API + Analytics Data API enabled
GOOGLE_PROJECT_ID=your-gcp-project-id

# Optional convenience default — per-project property_id is better in AGENTS.md
# GA4_PROPERTY_ID=
