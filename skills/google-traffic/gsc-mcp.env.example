# Google Search Console MCP — copy values into ~/.zshrc, ~/.cursor/gsc-mcp.env, or shell profile
# Docs: https://github.com/AminForou/mcp-gsc

# Absolute path to Desktop OAuth client JSON from Google Cloud Console (do not commit)
GSC_OAUTH_CLIENT_SECRETS_FILE=/Users/YOU/.cursor/google-gsc-oauth-client.json

# Optional convenience default — per-project site_url is better in AGENTS.md
# GSC_DEFAULT_SITE=sc-domain:example.com
