# Google Traffic auth — copy into shell profile or MCP env / envFile
# Paths: see auth-reference.md

# GA4 ADC — see auth-reference.md § GA4
GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/.config/gcloud/application_default_credentials.json

# GCP project with Analytics Admin + Analytics Data API enabled (not GA4 property_id)
GOOGLE_PROJECT_ID=your-gcp-project-id

# GSC — Desktop OAuth client JSON from Google Cloud Console (do not commit)
GSC_OAUTH_CLIENT_SECRETS_FILE=/Users/YOU/.config/gcloud/gsc-oauth-client.json

# Scope belongs in each repo AGENTS.md — do not set globally:
# GA4_PROPERTY_ID=
# GSC_DEFAULT_SITE=
